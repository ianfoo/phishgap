  {"date": "1994-11-25", "venue": "UIC Pavilion, University of Illinois", "city": "Chicago", "state": "IL", "gap": 11, "set": "1", "out": ">", "nb": 1, "prev": "Split Open and Melt", "next": "Julius"},
  {"date": "1995-06-16", "venue": "Walnut Creek Amphitheater", "city": "Raleigh", "state": "NC", "gap": 25, "set": "1", "jamchart": true, "jam": "The watery sounds produced by Trey's use of the Leslie percoloate throughout this great version. Add fantastic Page and Fish, with his uncharacteristic rim shots, and an unusual and highly engaging concluding Trey solo, and it adds up to a stellar performance.", "out": ">", "nb": 1, "prev": "Down with Disease", "in": ">", "next": "Ya Mar"},
