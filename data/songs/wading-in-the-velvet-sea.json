  {"date": "2013-10-23", "venue": "Glens Falls Civic Center", "city": "Glens Falls", "state": "NY", "gap": 4, "set": "2", "jamchart": true, "jam": "Following a strong &quot;Twist,&quot; this heartfelt rendering of &quot;Wading&quot; provides a graceful interlude before a powerful &quot;Hood.&quot;", "out": ">"},
