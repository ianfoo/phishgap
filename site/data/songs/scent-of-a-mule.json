  {"date": "1995-10-14", "venue": "Austin Music Hall", "city": "Austin", "state": "TX", "gap": 6, "set": "2", "jamchart": true, "jam": "Scat singing and playing by Trey in response to Page's solo. Another long Page solo. Prayer-like chanting from Mike before return to lyrics.", "nb": 1, "prev": "Hello My Baby", "next": "Cavern"},
  {"date": "1995-10-20", "venue": "Five Seasons Arena", "city": "Cedar Rapids", "state": "IA", "gap": 4, "set": "2", "out": ">", "nb": 1, "prev": "Timber (Jerry the Mule)", "in": ">", "next": "Simple"},
  {"date": "1995-10-25", "venue": "St. Paul Civic Center", "city": "St. Paul", "state": "MN", "gap": 4, "set": "1", "nb": 1, "prev": "The Wedge", "next": "Free"},
  {"date": "1995-10-28", "venue": "The Palace of Auburn Hills", "city": "Auburn Hills", "state": "MI", "gap": 2, "set": "2", "jamchart": true, "jam": "Wild Page solo with Trey and Fish joining at times > Trey scat singing and guitar > Page solo with Trey singing along > Page alone on piano > klezmer > wierd extended falsetto singing by Mike > ending.", "nb": 1, "prev": "Theme from the Bottom", "in": ">", "next": "You Enjoy Myself"},
  {"date": "1995-11-10", "venue": "The Fox Theatre", "city": "Atlanta", "state": "GA", "gap": 4, "set": "2", "jamchart": true, "jam": "Vocal/guitar jam by Trey responding to Page. Trey is nuts! Trey vocally joins Page at end of his second solo. Fishman kicks in on drums to bring on the klezmer. More crazy falsetto/baritone singing by Mike.", "nb": 1, "prev": "Free", "next": "You Enjoy Myself"},
  {"date": "1995-11-15", "venue": "Sun Dome, University of South Florida", "city": "Tampa", "state": "FL", "gap": 4, "set": "2", "jamchart": true, "jam": "Page solo > Trey singing scat and playing guitar with great audience reaction > Page solo > klezmer > prayer-like chanting from Mike > ending.", "out": ">", "nb": 1, "prev": "Theme from the Bottom", "in": ">", "next": "Mike's Song"},
  {"date": "1995-11-19", "venue": "Charlotte Coliseum", "city": "Charlotte", "state": "NC", "gap": 3, "set": "2", "jamchart": true, "jam": "Vocal and guitar response by Trey, but very different from all the preceding versions. Page picks up Trey's musical theme in his second solo. Mike adds his part with extended chanting before the return to lyrics.", "nb": 1, "prev": "Billy Breathes", "next": "Harry Hood"},
  {"date": "1995-11-24", "venue": "Civic Arena", "city": "Pittsburgh", "state": "PA", "gap": 3, "set": "2", "jamchart": true, "jam": "Typically strong Page solo followed by Trey on vocals and guitar. This one gets crazy as it picks up tempo and pitch. Another Page solo, klezmer, bizarre chanting from Mike, and ending.", "nb": 1, "prev": "Catapult", "next": "Bathtub Gin"},
  {"date": "1995-11-30", "venue": "Ervin J. Nutter Center, Wright State University", "city": "Dayton", "state": "OH", "gap": 4, "set": "2", "jamchart": true, "jam": "Trey follows Page's long solo with some vocals, but mostly a beautiful guitar solo. Page responds in kind, with marvelous classical piano stylings.", "nb": 1, "prev": "Run Like an Antelope", "in": ">", "next": "Free"},
  {"date": "1995-12-05", "venue": "Mullins Center, University of Massachusetts", "city": "Amherst", "state": "MA", "gap": 4, "set": "2", "jamchart": true, "jam": "Page solos, then comes Trey on vocals/guitar, but the vocals are very atypical. Page responds with another strong solo, the klezmer starts, followed by Mike chanting and stomping his feet. On the final beat of the song, the band breaks into a high-powered, accelerating jam that lasts for 1:34 until abruptly transitioning to \"Lifeboy.\"", "out": ">", "nb": 1, "prev": "Keyboard Army", "next": "Jam"},
  {"date": "1995-12-11", "venue": "Cumberland County Civic Center", "city": "Portland", "state": "ME", "gap": 4, "set": "2", "jamchart": true, "jam": "Vocal and guitar response by Trey is hilarious and wild. Page responds back with another long and dramatic solo; the klezmer, and more weird chanting from Mike.", "nb": 1, "prev": "Taste That Surrounds", "next": "Harry Hood"},
  {"date": "1995-12-16", "venue": "Olympic Center", "city": "Lake Placid", "state": "NY", "gap": 4, "set": "2", "jamchart": true, "jam": "More '95 style \"Mule Duel\" wackiness, with the expected Trey guitar/vocal response, more Page soloing, and Mike chanting with a brief snore.", "nb": 1, "prev": "Reba", "next": "Cavern"},
  {"date": "1995-12-30", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 4, "set": "2", "jamchart": true, "jam": "Great Page > Trey guitar/vocal > Page piano with Trey backing on guitar > klezmer > Mike singing high, then really low.", "out": ">", "nb": 1, "prev": "Lifeboy", "next": "Cavern"},
  {"date": "1996-04-26", "venue": "New Orleans Fairgrounds", "city": "New Orleans", "state": "LA", "gap": 2, "set": "1", "out": ">", "nb": 1, "prev": "Wolfman's Brother", "in": ">", "next": "Also Sprach Zarathustra"},
  {"date": "1996-06-06", "venue": "Joyous Lake", "city": "Woodstock", "state": "NY", "gap": 1, "set": "1", "jamchart": true, "jam": "\"Sunshine Of Your Love\" tease and Trey on keys for a portion of the Duel. An odd Duel for sure with howling and strange sounds, crazy Page, and chanting by Mike. Released on Live Bait Vol. 4.", "note": "Trey on keys for portions.", "nb": 1, "prev": "Big Black Furry Creature from Mars", "next": "Highway to Hell"},
