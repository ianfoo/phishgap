  {"date": "1996-08-10", "venue": "Alpine Valley Music Theatre", "city": "East Troy", "state": "WI", "gap": 4, "set": "2", "jamchart": true, "jam": "\"Sunshine Of Your Love\" tease by Page during solo. Guitar/vocal response by Trey. He gets pretty crazy, screaming. A lot of noise - percussion, guitar - during Page's second solo. Chanting.", "nb": 1, "prev": "Down with Disease", "in": ">", "next": "Free"},
  {"date": "1996-08-17", "venue": "Plattsburgh Air Force Base", "city": "Plattsburgh", "state": "NY", "gap": 5, "set": "3", "jamchart": true, "jam": "The others encroach on Page's solo, then back off. Fishman takes over on drums for an extended solo. Page responds with his own solo. Finally, arrival at the familiar klezmer pick-up, chanting and finale.", "note": "Page/Fish Mule Duel.", "nb": 1, "prev": "Frankenstein", "next": "Tweezer"},
  {"date": "1996-10-17", "venue": "Bryce Jordan Center, Penn State University", "city": "State College", "state": "PA", "gap": 2, "set": "2", "jamchart": true, "jam": "Guitar/vocal response by Trey. \"DEG\" -like jamming in Page's second solo by Page and Trey > klezmer and chanting.", "nb": 1, "prev": "Bathtub Gin", "next": "Free"},
