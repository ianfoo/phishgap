  {"date": "2013-07-05", "venue": "Saratoga Performing Arts Center", "city": "Saratoga Springs", "state": "NY", "gap": 25, "set": "2", "jamchart": true, "jam": "Perfect segue out of \"46 Days.\" Powerful, popular version, yet that is also controversial, given Trey's heavy reliance on the Digitech Whammy pitch shifter to call entire schools and species of whales.", "out": ">", "nb": 1, "prev": "46 Days", "in": "->", "next": "Drowned"},
