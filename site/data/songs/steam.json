  {"date": "2013-08-31", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 4, "set": "2", "out": "->", "nb": 1, "prev": "46 Days", "in": ">", "next": "Free"},
  {"date": "2013-10-19", "venue": "Hampton Coliseum", "city": "Hampton", "state": "VA", "gap": 3, "set": "2", "jamchart": true, "jam": "Features a surprising rhythm-based section with Trey joining in on drums and Mike playing his fight bell with drumsticks. Worth hearing for this journey \"outside the box\" alone.", "note": "Trey on drums; Mike playing his bass and fight bell (among other objects) with drumsticks.", "out": ">", "nb": 1, "prev": "Down with Disease", "in": ">", "next": "Prince Caspian"},
  {"date": "2013-12-28", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 11, "set": "2", "jamchart": true, "jam": "Among the finest versions to date, Trey's Echoplex adds extra power to the jam, which also features great playing from Page, weird shouts from Fish, and monstrous energy all throughout.", "out": ">", "nb": 1, "prev": "Backwards Down the Number Line", "next": "Silent in the Morning"},
