  {"date": "2015-08-02", "venue": "Tuscaloosa Amphitheater", "city": "Tuscaloosa", "state": "AL", "gap": 4, "set": "1", "out": ">", "nb": 1, "prev": "My Friend, My Friend", "next": "Cavern"},
