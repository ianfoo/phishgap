  {"date": "2023-08-04", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 7, "set": "1", "jamchart": true, "jam": "Jam starts with typical play before the band hooks up on a major key motif. High level interplay follows, and Trey touches the sky with a long, sustained note which culminates in a full band crescendo. The energy shifts towards minor key before returning to the \"46 Days\" riff to close.", "out": ">", "nb": 1, "prev": "The Moma Dance", "next": "Back in the Bubble"},
  {"date": "2023-09-02", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 6, "set": "2", "jamchart": true, "jam": "A surprising but smooth segue out of new song \"Ether Edge\" begins this wild version of the perennial Dick's favorite. Fishman's heavy attack provides the base on which the band bangs out a percussive stomp of rhythmic interplay. Trey engages with snarl early on, setting an aggressive tone before lightening things up, turning on the melody machine, and leading the band over a groove laden double-peak that > to \"The Howling\". Exceptional.", "out": ">", "nb": 1, "prev": "Ether Edge", "in": "->", "next": "The Howling"},
  {"date": "2023-10-06", "venue": "Bridgestone Arena", "city": "Nashville", "state": "TN", "gap": 2, "set": "e", "out": ">", "nb": 1, "prev": "Bouncing Around the Room", "in": ">", "next": "Run Like an Antelope"},
