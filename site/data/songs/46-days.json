 "performances": [
  {"date": "2002-12-14", "venue": "Studio 8H, NBC Studios", "city": "New York", "state": "NY", "gap": 0, "set": "1", "nb": 1, "first": 1, "next": "Chalk Dust Torture"},
  {"date": "2003-01-02", "venue": "Hampton Coliseum", "city": "Hampton", "state": "VA", "gap": 1363, "set": "2", "jamchart": true, "jam": "Debut. Jam gradually settles down from high powered \"46 Days\"-style in to a subtle, Trey and Page led foray. Picking up rhythm and energy, there are \"CYHMK\" teases as the jam builds in intensity. Settles down at the ending with no return to \"46 Days\" proper.", "note": "Debut.", "out": ">", "nb": 1, "xprev": "Character Zero", "next": "Simple"},
  {"date": "2003-02-15", "venue": "Thomas & Mack Center", "city": "Las Vegas", "state": "NV", "gap": 4, "set": "1", "nb": 1, "prev": "Life on Mars?", "next": "It's Ice"},
  {"date": "2003-02-25", "venue": "First Union Spectrum", "city": "Philadelphia", "state": "PA", "gap": 7, "set": "1", "nb": 1, "prev": "Talk", "next": "Taste"},
  {"date": "2003-07-10", "venue": "Shoreline Amphitheatre", "city": "Mountain View", "state": "CA", "gap": 7, "set": "2", "nb": 1, "xprev": "Run Like an Antelope", "next": "Divided Sky"},
  {"date": "2003-07-21", "venue": "Verizon Wireless Music Center", "city": "Noblesville", "state": "IN", "gap": 7, "set": "2", "jamchart": true, "jam": "Jam moves on from the typical hard driving standard to some really serene, quiet thoughtful space. With lots of little twists and turns, this one is very improvisational. > to \"Tweezer.\"", "out": ">", "nb": 1, "prev": "Taste", "next": "Tweezer"},
  {"date": "2003-08-03", "venue": "Loring Commerce Centre", "city": "Limestone", "state": "ME", "gap": 10, "set": "3", "jamchart": true, "jam": "Haunting, thrumming, mind blowing, and masterful. The band wastes little time departing from \"46 Days\" and descends into an underworld soundscape filled with all sorts of chilling effects, eerie sounds and more. After nearly 20 minutes of deep exploration, the band resurfaces with 15 minutes of (appropriately) low intensity, more musically oriented improvisation, and ultimately finishes off \"46 Days\" in the closing minutes.", "nb": 1, "xprev": "Loving Cup", "next": "Julius"},
  {"date": "2004-04-15", "venue": "Thomas & Mack Center", "city": "Las Vegas", "state": "NV", "gap": 9, "set": "2", "out": ">", "nb": 1, "xprev": "Timber (Jerry the Mule)", "next": "Drowned"},
  {"date": "2004-06-17", "venue": "KeySpan Park", "city": "Brooklyn", "state": "NY", "gap": 3, "set": "2", "jamchart": true, "jam": "Moves beyond \"46 Days\" into a swirling, more sedate segment. Jam then picks up a nice rhythmic pulse and great groove. The jam grows increasingly energized and intense, with a textbook -> to \"Possum.\"", "out": "->", "nb": 1, "xprev": "Frankenstein", "next": "Possum"},
